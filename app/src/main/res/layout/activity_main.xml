<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LAN BROWSER RELAY" android:textColor="@color/accent" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="STARTING" android:textColor="@color/success" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/lanAddressText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Finding LAN address…" android:textColor="@color/text" android:textSize="20sp"/>
        <TextView android:id="@+id/clientsText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Clients: 0" android:textColor="@color/muted" android:textSize="14sp"/>
        <TextView android:id="@+id/speedText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Speed: idle" android:textColor="@color/accent" android:textSize="15sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Live activity" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="150dp"
            android:layout_marginTop="5dp" android:background="@color/surface" android:fontFamily="monospace"
            android:padding="10dp" android:text="Starting service…" android:textColor="@color/muted" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Use the URL above on a phone connected to the same LAN. Browsing and downloads happen on the phone."
            android:textColor="@color/muted" android:textSize="13sp"/>
        <WebView android:id="@+id/previewWebView" android:layout_width="match_parent" android:layout_height="170dp"
            android:layout_marginTop="12dp" android:background="@color/surface"/>
    </LinearLayout>
</ScrollView>
